{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SaNDAI: Bootstrap local environment",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/bootstrap_local.sh",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SaNDAI: Shared Drive status",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/shared_drive_bridge.py", "status"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SaNDAI: Pull Shared Drive data",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/shared_drive_bridge.py", "pull"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SaNDAI: Run monitoring against Shared Drive",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/shared_drive_bridge.py", "run-monitoring"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SaNDAI: Push derived monitoring results",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/shared_drive_bridge.py", "push-results"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SaNDAI: Full Shared Drive monitoring cycle",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/shared_drive_bridge.py", "cycle"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SaNDAI: Test both notebooks",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["scripts/test_artifacts.py", "--all"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "SaNDAI: Test Shared Drive bridge",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["-m", "pytest", "-q", "-p", "no:cacheprovider", "tests/test_shared_drive_bridge.py"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
